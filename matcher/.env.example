# ═══════════════════════════════════════════════════════════════
# Orderbook Keeper Bot Configuration
# ═══════════════════════════════════════════════════════════════

# ── Orchestrator Keys (REQUIRED) ──────────────────────────────
# The keeper's private key (must be the orchestrator set in constructor)
PRIVATE_KEY=APrivateKey1zkp...

# View key for Record Scanner Service (REQUIRED if using RSS)
# Extract this using: node extract-viewkey.mjs
VIEW_KEY=AViewKey1...

# ── Record Scanner Service (OPTIONAL - Enhanced Order Discovery) ──
# Enable RSS for comprehensive record scanning vs legacy transaction scanning
USE_RECORD_SCANNER=true

# RSS API credentials (get from Provable console)
RSS_API_KEY=your-rss-api-key
RSS_CONSUMER_ID=your-rss-consumer-id

# ── Legacy Provable Scanner API (FALLBACK) ────────────────────
# Get credentials at https://provable.com
PROVABLE_CONSUMER_ID=your-consumer-id
PROVABLE_API_KEY=your-api-key

# Block to start scanning from (use deployment block)
SCANNER_START_BLOCK=14864000

# ── Program Configuration ─────────────────────────────────────
ORDERBOOK_PROGRAM=private_orderbook_v12.aleo
TOKEN_PROGRAM=mock_usdc_orderbook.aleo
NETWORK=testnet
NETWORK_ID=1

# ── Endpoints ─────────────────────────────────────────────────
API_ENDPOINT=https://api.explorer.provable.com/v1/testnet
QUERY_ENDPOINT=https://api.explorer.provable.com/v1
BROADCAST_ENDPOINT=https://api.explorer.provable.com/v1/testnet/transaction/broadcast

# ── Intervals (milliseconds) ──────────────────────────────────
SCAN_INTERVAL=30000
MATCH_INTERVAL=10000

# ── HTTP API ──────────────────────────────────────────────────
API_PORT=3002
FRONTEND_ORIGIN=*

# ── Addresses (optional, fetched from chain if not set) ───────
# ORCHESTRATOR_ADDR=aleo1...
# TREASURY_ADDR=aleo1...

# ── Binary Path (optional) ────────────────────────────────────
# SNARKOS_PATH=snarkos
