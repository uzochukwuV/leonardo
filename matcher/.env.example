# ═══════════════════════════════════════════════════════════════
# Orderbook Keeper Bot v2 Configuration
# ═══════════════════════════════════════════════════════════════

# ── Orchestrator Keys (REQUIRED) ──────────────────────────────
# The keeper's private key (must be the orchestrator set in constructor)
# View key is derived automatically from private key
PRIVATE_KEY=APrivateKey1zkp...

# ── Provable Scanner API (REQUIRED) ───────────────────────────
# Get credentials at https://provable.com
PROVABLE_API_KEY=your-api-key
PROVABLE_CONSUMER_ID=your-consumer-id

# Block to start scanning from (use deployment block)
# On first run, if not set, defaults to current_block - 20000
SCANNER_START_BLOCK=15040000

# ── Program Configuration ─────────────────────────────────────
ORDERBOOK_PROGRAM=private_orderbook_v17.aleo
TOKEN_PROGRAM=mock_usdc_orderbook.aleo
NETWORK_ID=1

# ── Endpoints ─────────────────────────────────────────────────
QUERY_ENDPOINT=https://api.explorer.provable.com/v1
BROADCAST_ENDPOINT=https://api.explorer.provable.com/v1/testnet/transaction/broadcast

# ── Intervals (milliseconds) ──────────────────────────────────
SCAN_INTERVAL=30000
MATCH_INTERVAL=10000

# ── HTTP API ──────────────────────────────────────────────────
API_PORT=3002
FRONTEND_ORIGIN=*

# ── Addresses (optional, fetched from chain if not set) ───────
# TREASURY_ADDR=aleo1...

# ── Program Address (for frontend token approvals) ────────────
# The program address is derived from the program ID and is needed
# for token approvals. Users must approve this address to spend tokens.
# To find it: Look up the deployment transaction or compute it from
# the program ID using the Aleo SDK.
# ORDERBOOK_PROGRAM_ADDRESS=aleo1...

# ── Binary Path (optional) ────────────────────────────────────
# SNARKOS_PATH=snarkos
