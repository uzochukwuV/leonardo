import credits.aleo;
import token_registry.aleo;
program private_orderbook_v4.aleo;

record TickOrder:
    owner as address.private;
    token_pair as u64.private;
    tick_lower as u64.private;
    tick_upper as u64.private;
    is_buy as boolean.private;
    quantity as u128.private;
    limit_price as u64.private;
    token_id as field.private;
    escrowed_amount as u128.private;
    filled as u128.private;
    nonce as field.private;
    timestamp as u32.private;
    expires_at as u32.private;

record Settlement:
    owner as address.private;
    token_pair as u64.private;
    quantity as u128.private;
    price as u64.private;
    is_buy as boolean.private;
    timestamp as u32.private;

struct TokenPair:
    pair_id as u64;
    base_token_id as field;
    quote_token_id as field;
    tick_size as u64;
    active as boolean;
    settler_fee_bps as u64;
    protocol_fee_bps as u64;
    treasury as address;

struct TickInfo:
    token_pair as u64;
    tick_id as u64;
    order_count as u32;
    total_volume_settled as u128;
    last_updated as u32;

struct EscrowInfo:
    depositor as address;
    token_id as field;
    amount as u128;
    order_tick_key as field;

struct SettleInfo:
    token_pair as u64;
    buyer as address;
    seller as address;
    quote_token_id as field;
    base_token_id as field;
    fill_qty as u128;
    quote_gross as u128;
    buy_remaining as u128;
    sell_remaining as u128;

struct TickRange:
    buy_lower as u64;
    buy_upper as u64;
    sell_lower as u64;
    sell_upper as u64;

struct TokenMetadata:
    token_id as field;
    name as u128;
    symbol as u128;
    decimals as u8;
    supply as u128;
    max_supply as u128;
    admin as address;
    external_authorization_required as boolean;
    external_authorization_party as address;

struct TokenOwner:
    account as address;
    token_id as field;

mapping admin:
    key as boolean.public;
    value as address.public;

mapping token_pairs:
    key as u64.public;
    value as TokenPair.public;

mapping tick_registry:
    key as field.public;
    value as TickInfo.public;

mapping escrow_registry:
    key as field.public;
    value as EscrowInfo.public;

mapping total_escrowed:
    key as field.public;
    value as u128.public;

mapping order_counter:
    key as boolean.public;
    value as u64.public;

function initialize_admin:
    async initialize_admin self.caller into r0;
    output r0 as private_orderbook_v4.aleo/initialize_admin.future;

finalize initialize_admin:
    input r0 as address.public;
    contains admin[true] into r1;
    not r1 into r2;
    assert.eq r2 true;
    set r0 into admin[true];
    set 0u64 into order_counter[true];

function transfer_admin:
    input r0 as address.public;
    async transfer_admin self.caller r0 into r1;
    output r1 as private_orderbook_v4.aleo/transfer_admin.future;

finalize transfer_admin:
    input r0 as address.public;
    input r1 as address.public;
    get admin[true] into r2;
    assert.eq r0 r2;
    set r1 into admin[true];

function register_token_pair:
    input r0 as u64.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as u64.public;
    input r4 as u64.public;
    input r5 as u64.public;
    input r6 as address.public;
    gt r0 0u64 into r7;
    assert.eq r7 true;
    is.neq r1 r2 into r8;
    assert.eq r8 true;
    gt r3 0u64 into r9;
    assert.eq r9 true;
    lte r4 200u64 into r10;
    assert.eq r10 true;
    lte r5 100u64 into r11;
    assert.eq r11 true;
    async register_token_pair self.caller r0 r1 r2 r3 r4 r5 r6 into r12;
    output r12 as private_orderbook_v4.aleo/register_token_pair.future;

finalize register_token_pair:
    input r0 as address.public;
    input r1 as u64.public;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as u64.public;
    input r5 as u64.public;
    input r6 as u64.public;
    input r7 as address.public;
    get admin[true] into r8;
    assert.eq r0 r8;
    contains token_pairs[r1] into r9;
    not r9 into r10;
    assert.eq r10 true;
    cast r1 r2 r3 r4 true r5 r6 r7 into r11 as TokenPair;
    set r11 into token_pairs[r1];

function submit_order_with_escrow:
    input r0 as u64.public;
    input r1 as boolean.public;
    input r2 as u64.public;
    input r3 as u64.public;
    input r4 as u32.public;
    input r5 as u32.public;
    input r6 as u64.private;
    input r7 as u128.private;
    input r8 as field.public;
    gt r7 0u128 into r9;
    assert.eq r9 true;
    gte r3 r2 into r10;
    assert.eq r10 true;
    cast r6 into r11 as u128;
    mul r7 r11 into r12;
    add r12 9999u128 into r13;
    div r13 10000u128 into r14;
    ternary r1 r14 r7 into r15;
    call token_registry.aleo/transfer_from_public r8 self.caller private_orderbook_v4.aleo r15 into r16;
    cast self.caller into r17 as field;
    cast r2 into r18 as field;
    add r17 r18 into r19;
    cast r3 into r20 as field;
    add r19 r20 into r21;
    cast r4 into r22 as field;
    add r21 r22 into r23;
    hash.bhp256 r23 into r24 as field;
    cast self.signer r0 r2 r3 r1 r7 r6 r8 r15 0u128 r24 r4 r5 into r25 as TickOrder.record;
    async submit_order_with_escrow r0 r1 r2 r3 self.signer r8 r15 r24 r6 r5 r16 into r26;
    output r25 as TickOrder.record;
    output r26 as private_orderbook_v4.aleo/submit_order_with_escrow.future;

finalize submit_order_with_escrow:
    input r0 as u64.public;
    input r1 as boolean.public;
    input r2 as u64.public;
    input r3 as u64.public;
    input r4 as address.public;
    input r5 as field.public;
    input r6 as u128.public;
    input r7 as field.public;
    input r8 as u64.public;
    input r9 as u32.public;
    input r10 as token_registry.aleo/transfer_from_public.future;
    await r10;
    get token_pairs[r0] into r11;
    assert.eq r11.active true;
    ternary r1 r11.quote_token_id r11.base_token_id into r12;
    assert.eq r5 r12;
    mul 50u64 r11.tick_size into r13;
    sub r3 r2 into r14;
    lte r14 r13 into r15;
    assert.eq r15 true;
    mul r2 r11.tick_size into r16;
    gte r8 r16 into r17;
    assert.eq r17 true;
    add r3 1u64 into r18;
    mul r18 r11.tick_size into r19;
    lte r8 r19 into r20;
    assert.eq r20 true;
    gt r9 0u32 into r21;
    branch.eq r21 false to end_then_0_0;
    gt r9 block.height into r22;
    assert.eq r22 true;
    branch.eq true true to end_otherwise_0_1;
    position end_then_0_0;
    position end_otherwise_0_1;
    get order_counter[true] into r23;
    add r23 1u64 into r24;
    set r24 into order_counter[true];
    cast r24 into r25 as field;
    add r7 r25 into r26;
    hash.bhp256 r26 into r27 as field;
    cast r4 r5 r6 r27 into r28 as EscrowInfo;
    set r28 into escrow_registry[r27];
    get.or_use total_escrowed[r5] 0u128 into r29;
    add r29 r6 into r30;
    set r30 into total_escrowed[r5];
    add r2 r3 into r31;
    div r31 2u64 into r32;
    cast r0 into r33 as u128;
    cast r32 into r34 as u128;
    mul r34 1000000u128 into r35;
    add r33 r35 into r36;
    hash.bhp256 r36 into r37 as field;
    cast r0 r32 0u32 0u128 0u32 into r38 as TickInfo;
    get.or_use tick_registry[r37] r38 into r39;
    add r39.order_count 1u32 into r40;
    cast r39.token_pair r39.tick_id r40 r39.total_volume_settled block.height into r41 as TickInfo;
    set r41 into tick_registry[r37];

function cancel_order_public_escrow:
    input r0 as TickOrder.record;
    input r1 as field.public;
    is.eq r0.owner self.caller into r2;
    assert.eq r2 true;
    lt r0.filled r0.quantity into r3;
    assert.eq r3 true;
    cast r0.limit_price into r4 as u128;
    mul r0.filled r4 into r5;
    add r5 9999u128 into r6;
    div r6 10000u128 into r7;
    ternary r0.is_buy r7 r0.filled into r8;
    sub r0.escrowed_amount r8 into r9;
    call token_registry.aleo/transfer_from_public r0.token_id private_orderbook_v4.aleo r0.owner r9 into r10;
    async cancel_order_public_escrow r1 r0.token_id r9 r0.token_pair r0.tick_lower r0.tick_upper r0.owner r10 into r11;
    output r11 as private_orderbook_v4.aleo/cancel_order_public_escrow.future;

finalize cancel_order_public_escrow:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as u128.public;
    input r3 as u64.public;
    input r4 as u64.public;
    input r5 as u64.public;
    input r6 as address.public;
    input r7 as token_registry.aleo/transfer_from_public.future;
    await r7;
    get escrow_registry[r0] into r8;
    assert.eq r8.depositor r6;
    remove escrow_registry[r0];
    get total_escrowed[r1] into r9;
    sub r9 r2 into r10;
    set r10 into total_escrowed[r1];
    add r4 r5 into r11;
    div r11 2u64 into r12;
    cast r3 into r13 as u128;
    cast r12 into r14 as u128;
    mul r14 1000000u128 into r15;
    add r13 r15 into r16;
    hash.bhp256 r16 into r17 as field;
    get tick_registry[r17] into r18;
    sub r18.order_count 1u32 into r19;
    cast r18.token_pair r18.tick_id r19 r18.total_volume_settled block.height into r20 as TickInfo;
    set r20 into tick_registry[r17];

function settle_match_public:
    input r0 as TickOrder.record;
    input r1 as TickOrder.record;
    input r2 as u32.public;
    assert.eq r0.token_pair r1.token_pair;
    is.eq r0.is_buy true into r3;
    assert.eq r3 true;
    is.eq r1.is_buy false into r4;
    assert.eq r4 true;
    gt r0.tick_lower r1.tick_lower into r5;
    ternary r5 r0.tick_lower r1.tick_lower into r6;
    lt r0.tick_upper r1.tick_upper into r7;
    ternary r7 r0.tick_upper r1.tick_upper into r8;
    lte r6 r8 into r9;
    assert.eq r9 true;
    gte r0.limit_price r1.limit_price into r10;
    assert.eq r10 true;
    lt r0.filled r0.quantity into r11;
    assert.eq r11 true;
    lt r1.filled r1.quantity into r12;
    assert.eq r12 true;
    add r0.limit_price r1.limit_price into r13;
    div r13 2u64 into r14;
    sub r0.quantity r0.filled into r15;
    sub r1.quantity r1.filled into r16;
    lt r15 r16 into r17;
    ternary r17 r15 r16 into r18;
    cast r14 into r19 as u128;
    mul r18 r19 into r20;
    add r20 9999u128 into r21;
    div r21 10000u128 into r22;
    call token_registry.aleo/transfer_from_public r1.token_id private_orderbook_v4.aleo r0.owner r18 into r23;
    call token_registry.aleo/transfer_from_public r0.token_id private_orderbook_v4.aleo r1.owner r22 into r24;
    sub r0.escrowed_amount r22 into r25;
    add r0.filled r18 into r26;
    cast r0.owner r0.token_pair r0.tick_lower r0.tick_upper r0.is_buy r0.quantity r0.limit_price r0.token_id r25 r26 r0.nonce r0.timestamp r0.expires_at into r27 as TickOrder.record;
    sub r1.escrowed_amount r18 into r28;
    add r1.filled r18 into r29;
    cast r1.owner r1.token_pair r1.tick_lower r1.tick_upper r1.is_buy r1.quantity r1.limit_price r1.token_id r28 r29 r1.nonce r1.timestamp r1.expires_at into r30 as TickOrder.record;
    sub r0.quantity r0.filled into r31;
    sub r1.quantity r1.filled into r32;
    cast r0.token_pair r0.owner r1.owner r0.token_id r1.token_id r18 r22 r31 r32 into r33 as SettleInfo;
    cast r0.tick_lower r0.tick_upper r1.tick_lower r1.tick_upper into r34 as TickRange;
    cast r0.owner r0.token_pair r18 r14 true r2 into r35 as Settlement.record;
    cast r1.owner r1.token_pair r18 r14 false r2 into r36 as Settlement.record;
    async settle_match_public r33 r34 self.caller r23 r24 into r37;
    output r27 as TickOrder.record;
    output r30 as TickOrder.record;
    output r35 as Settlement.record;
    output r36 as Settlement.record;
    output r37 as private_orderbook_v4.aleo/settle_match_public.future;

finalize settle_match_public:
    input r0 as SettleInfo.public;
    input r1 as TickRange.public;
    input r2 as address.public;
    input r3 as token_registry.aleo/transfer_from_public.future;
    input r4 as token_registry.aleo/transfer_from_public.future;
    await r3;
    await r4;
    get token_pairs[r0.token_pair] into r5;
    cast r5.settler_fee_bps into r6 as u128;
    mul r0.quote_gross r6 into r7;
    div r7 10000u128 into r8;
    cast r5.protocol_fee_bps into r9 as u128;
    mul r0.quote_gross r9 into r10;
    div r10 10000u128 into r11;
    get total_escrowed[r0.base_token_id] into r12;
    sub r12 r0.fill_qty into r13;
    set r13 into total_escrowed[r0.base_token_id];
    get total_escrowed[r0.quote_token_id] into r14;
    add r0.quote_gross r8 into r15;
    add r15 r11 into r16;
    sub r14 r16 into r17;
    set r17 into total_escrowed[r0.quote_token_id];
    gte r0.fill_qty r0.buy_remaining into r18;
    gte r0.fill_qty r0.sell_remaining into r19;
    add r1.buy_lower r1.buy_upper into r20;
    div r20 2u64 into r21;
    add r1.sell_lower r1.sell_upper into r22;
    div r22 2u64 into r23;
    cast r0.token_pair into r24 as u128;
    cast r21 into r25 as u128;
    mul r25 1000000u128 into r26;
    add r24 r26 into r27;
    hash.bhp256 r27 into r28 as field;
    cast r0.token_pair into r29 as u128;
    cast r23 into r30 as u128;
    mul r30 1000000u128 into r31;
    add r29 r31 into r32;
    hash.bhp256 r32 into r33 as field;
    get tick_registry[r28] into r34;
    sub r34.order_count 1u32 into r35;
    ternary r18 r35 r34.order_count into r36;
    add r34.total_volume_settled r0.fill_qty into r37;
    cast r34.token_pair r34.tick_id r36 r37 block.height into r38 as TickInfo;
    set r38 into tick_registry[r28];
    get tick_registry[r33] into r39;
    sub r39.order_count 1u32 into r40;
    ternary r19 r40 r39.order_count into r41;
    add r39.total_volume_settled r0.fill_qty into r42;
    cast r39.token_pair r39.tick_id r41 r42 block.height into r43 as TickInfo;
    set r43 into tick_registry[r33];

function settle_match_public_with_keys:
    input r0 as TickOrder.record;
    input r1 as TickOrder.record;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as u32.public;
    assert.eq r0.token_pair r1.token_pair;
    is.eq r0.is_buy true into r5;
    assert.eq r5 true;
    is.eq r1.is_buy false into r6;
    assert.eq r6 true;
    gt r0.tick_lower r1.tick_lower into r7;
    ternary r7 r0.tick_lower r1.tick_lower into r8;
    lt r0.tick_upper r1.tick_upper into r9;
    ternary r9 r0.tick_upper r1.tick_upper into r10;
    lte r8 r10 into r11;
    assert.eq r11 true;
    gte r0.limit_price r1.limit_price into r12;
    assert.eq r12 true;
    lt r0.filled r0.quantity into r13;
    assert.eq r13 true;
    lt r1.filled r1.quantity into r14;
    assert.eq r14 true;
    add r0.limit_price r1.limit_price into r15;
    div r15 2u64 into r16;
    sub r0.quantity r0.filled into r17;
    sub r1.quantity r1.filled into r18;
    lt r17 r18 into r19;
    ternary r19 r17 r18 into r20;
    cast r16 into r21 as u128;
    mul r20 r21 into r22;
    add r22 9999u128 into r23;
    div r23 10000u128 into r24;
    call token_registry.aleo/transfer_from_public r1.token_id private_orderbook_v4.aleo r0.owner r20 into r25;
    call token_registry.aleo/transfer_from_public r0.token_id private_orderbook_v4.aleo r1.owner r24 into r26;
    sub r0.escrowed_amount r24 into r27;
    add r0.filled r20 into r28;
    cast r0.owner r0.token_pair r0.tick_lower r0.tick_upper r0.is_buy r0.quantity r0.limit_price r0.token_id r27 r28 r0.nonce r0.timestamp r0.expires_at into r29 as TickOrder.record;
    sub r1.escrowed_amount r20 into r30;
    add r1.filled r20 into r31;
    cast r1.owner r1.token_pair r1.tick_lower r1.tick_upper r1.is_buy r1.quantity r1.limit_price r1.token_id r30 r31 r1.nonce r1.timestamp r1.expires_at into r32 as TickOrder.record;
    sub r0.quantity r0.filled into r33;
    sub r1.quantity r1.filled into r34;
    cast r0.token_pair r0.owner r1.owner r0.token_id r1.token_id r20 r24 r33 r34 into r35 as SettleInfo;
    cast r0.tick_lower r0.tick_upper r1.tick_lower r1.tick_upper into r36 as TickRange;
    cast r0.owner r0.token_pair r20 r16 true r4 into r37 as Settlement.record;
    cast r1.owner r1.token_pair r20 r16 false r4 into r38 as Settlement.record;
    async settle_match_public_with_keys r35 r36 r2 r3 self.caller r25 r26 into r39;
    output r29 as TickOrder.record;
    output r32 as TickOrder.record;
    output r37 as Settlement.record;
    output r38 as Settlement.record;
    output r39 as private_orderbook_v4.aleo/settle_match_public_with_keys.future;

finalize settle_match_public_with_keys:
    input r0 as SettleInfo.public;
    input r1 as TickRange.public;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as address.public;
    input r5 as token_registry.aleo/transfer_from_public.future;
    input r6 as token_registry.aleo/transfer_from_public.future;
    await r5;
    await r6;
    get token_pairs[r0.token_pair] into r7;
    get escrow_registry[r2] into r8;
    get escrow_registry[r3] into r9;
    assert.eq r8.depositor r0.buyer;
    assert.eq r9.depositor r0.seller;
    gte r0.fill_qty r0.buy_remaining into r10;
    gte r0.fill_qty r0.sell_remaining into r11;
    branch.eq r10 false to end_then_0_2;
    remove escrow_registry[r2];
    branch.eq true true to end_otherwise_0_3;
    position end_then_0_2;
    sub r8.amount r0.quote_gross into r12;
    cast r8.depositor r8.token_id r12 r8.order_tick_key into r13 as EscrowInfo;
    set r13 into escrow_registry[r2];
    position end_otherwise_0_3;
    branch.eq r11 false to end_then_0_4;
    remove escrow_registry[r3];
    branch.eq true true to end_otherwise_0_5;
    position end_then_0_4;
    sub r9.amount r0.fill_qty into r14;
    cast r9.depositor r9.token_id r14 r9.order_tick_key into r15 as EscrowInfo;
    set r15 into escrow_registry[r3];
    position end_otherwise_0_5;
    cast r7.settler_fee_bps into r16 as u128;
    mul r0.quote_gross r16 into r17;
    div r17 10000u128 into r18;
    cast r7.protocol_fee_bps into r19 as u128;
    mul r0.quote_gross r19 into r20;
    div r20 10000u128 into r21;
    get total_escrowed[r0.base_token_id] into r22;
    sub r22 r0.fill_qty into r23;
    set r23 into total_escrowed[r0.base_token_id];
    get total_escrowed[r0.quote_token_id] into r24;
    add r0.quote_gross r18 into r25;
    add r25 r21 into r26;
    sub r24 r26 into r27;
    set r27 into total_escrowed[r0.quote_token_id];
    add r1.buy_lower r1.buy_upper into r28;
    div r28 2u64 into r29;
    add r1.sell_lower r1.sell_upper into r30;
    div r30 2u64 into r31;
    cast r0.token_pair into r32 as u128;
    cast r29 into r33 as u128;
    mul r33 1000000u128 into r34;
    add r32 r34 into r35;
    hash.bhp256 r35 into r36 as field;
    cast r0.token_pair into r37 as u128;
    cast r31 into r38 as u128;
    mul r38 1000000u128 into r39;
    add r37 r39 into r40;
    hash.bhp256 r40 into r41 as field;
    get tick_registry[r36] into r42;
    sub r42.order_count 1u32 into r43;
    ternary r10 r43 r42.order_count into r44;
    add r42.total_volume_settled r0.fill_qty into r45;
    cast r42.token_pair r42.tick_id r44 r45 block.height into r46 as TickInfo;
    set r46 into tick_registry[r36];
    get tick_registry[r41] into r47;
    sub r47.order_count 1u32 into r48;
    ternary r11 r48 r47.order_count into r49;
    add r47.total_volume_settled r0.fill_qty into r50;
    cast r47.token_pair r47.tick_id r49 r50 block.height into r51 as TickInfo;
    set r51 into tick_registry[r41];

function batch_settle_public:
    input r0 as TickOrder.record;
    input r1 as TickOrder.record;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as TickOrder.record;
    input r5 as TickOrder.record;
    input r6 as field.public;
    input r7 as field.public;
    input r8 as u32.public;
    assert.eq r0.token_pair r1.token_pair;
    is.eq r0.is_buy true into r9;
    assert.eq r9 true;
    is.eq r1.is_buy false into r10;
    assert.eq r10 true;
    gt r0.tick_lower r1.tick_lower into r11;
    ternary r11 r0.tick_lower r1.tick_lower into r12;
    lt r0.tick_upper r1.tick_upper into r13;
    ternary r13 r0.tick_upper r1.tick_upper into r14;
    lte r12 r14 into r15;
    assert.eq r15 true;
    gte r0.limit_price r1.limit_price into r16;
    assert.eq r16 true;
    lt r0.filled r0.quantity into r17;
    assert.eq r17 true;
    lt r1.filled r1.quantity into r18;
